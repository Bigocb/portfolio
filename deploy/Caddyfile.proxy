# Caddyfile for running behind Traefik / Cloudflare Tunnel.
# No automatic HTTPS or domain -- the tunnel/ingress terminates TLS and
# forwards plain HTTP to this container.

:80 {
	encode zstd gzip
	root * /srv/dist
	file_server

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	@hasExt {
		path_regexp \.(js|css|woff2?|ttf|otf|eot|svg|png|jpg|jpeg|gif|webp|ico)$
	}
	header @hasExt {
		Cache-Control "public, max-age=31536000, immutable"
	}

	@html {
		path_regexp \.html$|/$
	}
	header @html {
		Cache-Control "public, max-age=300"
	}

	handle_errors {
		rewrite * /404.html
		file_server
	}
}
