---
import Base from '../layouts/Base.astro';
import { experience, capabilities } from '../lib/synced';
---

<Base
  title="Experience | Robin Cloutier"
  description="Work history and experience of Robin Cloutier."
>
  <div class="container prose">
    <h1>Experience</h1>

    <div class="timeline">
      {experience.map(job => (
        <div class="timeline-entry">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <h2>{job.company}</h2>
            <p class="role">{job.title}</p>
            <p class="years">{job.years}</p>
            {job.public_note && <p class="note">{job.public_note}</p>}
          </div>
        </div>
      ))}
    </div>

    <section class="skills">
      <h2>Skills</h2>
      <ul class="capabilities-list">
        {capabilities.map(cap => (
          <li>
            <strong>{cap.title}</strong>
            <p>{cap.description}</p>
          </li>
        ))}
      </ul>
    </section>

    <div class="nav-back">
      <a href="/">← Back home</a>
    </div>
  </div>
</Base>

<style>
  .container {
    padding: 3rem var(--gutter);
    max-width: var(--measure);
  }

  .timeline {
    position: relative;
    margin: 2rem 0;
  }

  .timeline-entry {
    display: flex;
    gap: 2rem;
    margin-bottom: 2rem;
    position: relative;
  }

  .timeline-marker {
    width: 16px;
    height: 16px;
    background: var(--accent);
    border-radius: 50%;
    margin-top: 0.5rem;
    flex-shrink: 0;
  }

  .timeline-entry:not(:last-child) .timeline-marker::after {
    content: '';
    position: absolute;
    left: 7px;
    top: 24px;
    width: 2px;
    height: calc(100% + 2rem);
    background: var(--line);
  }

  .timeline-content h2 {
    margin: 0 0 0.25rem 0;
    font-size: 1.25rem;
  }

  .role {
    font-weight: 500;
    margin: 0.25rem 0 !important;
  }

  .years {
    font-size: 0.9rem;
    color: var(--muted);
    margin: 0.25rem 0 !important;
  }

  .note {
    font-size: 0.9rem;
    color: var(--muted);
    margin: 0.5rem 0 0 0 !important;
  }

  .skills {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .nav-back {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .nav-back a {
    color: var(--accent);
  }
</style>
