---
import Base from '../layouts/Base.astro';
import { identity, stats, capabilities, experience, projectsData } from '../lib/synced';

const featured = [...projectsData]
  .filter(p => p.public_slug && p.featured)
  .sort((a, b) => (a.sort_order ?? 999) - (b.sort_order ?? 999))
  .slice(0, 3);

const verifiedStats = stats.filter(s => s.verified);
---

<Base title={`${identity.display_name} | Senior Software Engineer`} description="Portfolio of Robin Cloutier, Senior Software Engineer focused on AI platform and infrastructure work.">
  <div class="hero">
    <div class="container">
      <h1>{identity.display_name}</h1>
      <p class="tagline">{identity.tagline}</p>
      <p class="pitch">{identity.pitch}</p>
      <div class="cta">
        <a href="/projects" class="btn">See projects</a>
        <a href="/resume" class="btn btn-secondary">Download resume</a>
      </div>
    </div>
  </div>

  {verifiedStats.length > 0 && (
    <section class="stats">
      <div class="container">
        {verifiedStats.map(stat => (
          <div class="stat-tile">
            <div class="stat-value">{stat.value}</div>
            <div class="stat-label">{stat.label}</div>
            {stat.footnote && <div class="stat-footnote">{stat.footnote}</div>}
          </div>
        ))}
      </div>
    </section>
  )}

  <section class="capabilities">
    <div class="container">
      <h2>Core capabilities</h2>
      <ul>
        {capabilities.map(cap => (
          <li>
            <strong>{cap.title}</strong>
            <p>{cap.description}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {experience.length > 0 && (
    <section class="experience">
      <div class="container">
        <h2>Career arc</h2>
        <div class="timeline">
          {experience.map(job => (
            <div class="timeline-entry">
              <div class="timeline-marker"></div>
              <div class="timeline-content">
                <h3>{job.company}</h3>
                <p class="role">{job.title}</p>
                <p class="years">{job.years}</p>
                {job.public_note && <p class="note">{job.public_note}</p>}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {featured.length > 0 && (
    <section class="featured-projects">
      <div class="container">
        <h2>Featured projects</h2>
        <div class="projects-grid">
          {featured.map(project => (
            <article class="project-card">
              <h3>
                <a href={`/projects/${project.public_slug}`}>
                  {project.name}
                </a>
              </h3>
              <p>{project.description}</p>
              <div class="card-meta">
                <span>{project.year}</span>
                <span>•</span>
                <span>{project.role}</span>
              </div>
              <a href={`/projects/${project.public_slug}`} class="read-more">
                Read more →
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="closing">
    <div class="container prose">
      <p>I connect AI agents to the systems they need and help get them safely into production: governed integrations, repeatable pipelines, and infrastructure that stays observable.</p>
      <div class="closing-links">
        <a href="/contact">Get in touch</a>
        <a href="/projects">See projects</a>
        <a href="/resume">View resume</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding: 4rem var(--gutter) 2rem;
  }

  .hero h1 {
    font-size: 3rem;
    margin-bottom: 0.5rem;
  }

  .tagline {
    font-size: 1.5rem;
    color: var(--muted);
    margin-bottom: 1rem;
  }

  .pitch {
    font-size: 1.1rem;
    max-width: var(--measure);
    margin-bottom: 2rem;
  }

  .cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: var(--accent);
    color: var(--bg);
    border-radius: 4px;
    font-weight: 500;
    text-decoration: none;
  }

  .btn:hover {
    opacity: 0.9;
  }

  .btn-secondary {
    background: transparent;
    border: 1px solid var(--accent);
    color: var(--accent);
  }

  .stats {
    padding: 3rem var(--gutter);
    background: var(--surface);
  }

  .stats .container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }

  .stat-tile {
    padding: 1.5rem;
    background: var(--bg);
    border-radius: 6px;
  }

  .stat-tile.placeholder {
    opacity: 0.5;
  }

  .stat-value {
    font-size: 2rem;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }

  .stat-label {
    font-size: 0.9rem;
    color: var(--muted);
  }

  .stat-footnote {
    font-size: 0.75rem;
    color: var(--muted);
    margin-top: 0.5rem;
  }

  .capabilities {
    padding: 3rem var(--gutter);
  }

  .capabilities h2 {
    margin-bottom: 2rem;
  }

  .capabilities ul {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    max-width: var(--grid-width);
  }

  .capabilities li {
    padding: 1rem;
    border-left: 3px solid var(--accent);
    padding-left: 1rem;
    list-style: none;
  }

  .capabilities li strong {
    display: block;
    margin-bottom: 0.5rem;
    font-size: 1.1rem;
  }

  .capabilities li p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .experience {
    padding: 3rem var(--gutter);
    background: var(--surface);
  }

  .experience h2 {
    margin-bottom: 2rem;
  }

  .timeline {
    position: relative;
    max-width: var(--measure);
  }

  .timeline-entry {
    display: flex;
    gap: 2rem;
    margin-bottom: 2rem;
    position: relative;
  }

  .timeline-marker {
    width: 16px;
    height: 16px;
    background: var(--accent);
    border-radius: 50%;
    margin-top: 0.5rem;
    flex-shrink: 0;
  }

  .timeline-entry:not(:last-child) .timeline-marker::after {
    content: '';
    position: absolute;
    left: 7px;
    top: 24px;
    width: 2px;
    height: calc(100% + 2rem);
    background: var(--line);
  }

  .timeline-content h3 {
    margin: 0 0 0.25rem 0;
    font-size: 1.1rem;
  }

  .timeline-content .role {
    font-weight: 500;
    margin: 0.25rem 0;
  }

  .timeline-content .years {
    font-size: 0.9rem;
    color: var(--muted);
    margin: 0.25rem 0;
  }

  .timeline-content .note {
    font-size: 0.9rem;
    color: var(--muted);
    margin: 0.5rem 0 0 0;
  }

  .featured-projects {
    padding: 3rem var(--gutter);
  }

  .featured-projects h2 {
    margin-bottom: 2rem;
  }

  .featured-projects .projects-grid {
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }

  .project-card {
    padding: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
  }

  .project-card h3 {
    margin-top: 0;
  }

  .project-card a {
    color: var(--accent);
  }

  .card-meta {
    display: flex;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--muted);
    margin: 1rem 0;
  }

  .read-more {
    display: inline-block;
    font-weight: 500;
    text-decoration: none;
  }

  .read-more:hover {
    text-decoration: underline;
  }

  .closing {
    padding: 3rem var(--gutter);
    text-align: center;
  }

  .closing p {
    font-size: 1.1rem;
    max-width: var(--measure);
    margin: 0 auto 2rem;
  }

  .closing-links {
    display: flex;
    gap: 2rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .closing-links a {
    padding: 0.75rem 1.5rem;
    background: var(--accent);
    color: var(--bg);
    border-radius: 4px;
    text-decoration: none;
    font-weight: 500;
    transition: opacity 0.2s;
  }

  .closing-links a:hover {
    opacity: 0.9;
  }

  @media (max-width: 768px) {
    .hero h1 {
      font-size: 2rem;
    }

    .tagline {
      font-size: 1.1rem;
    }

    .cta {
      flex-direction: column;
    }

    .btn {
      width: 100%;
      text-align: center;
    }

    .closing-links {
      flex-direction: column;
      gap: 1rem;
    }

    .closing-links a {
      width: 100%;
    }

    .timeline-entry {
      gap: 1rem;
    }
  }
</style>
