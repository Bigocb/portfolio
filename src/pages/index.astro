---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const allProjects = await getCollection('projects');
const featured = allProjects
  .filter(p => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<Base title="Robin Cloutier | Senior Software Engineer" description="Portfolio of Robin Cloutier, Senior Software Engineer focused on AI platform and infrastructure work.">
  <div class="hero">
    <div class="container">
      <h1>Robin Cloutier</h1>
      <p class="tagline">Senior Software Engineer | AI Platform and Infrastructure</p>
      <p class="pitch">I build the plumbing that lets AI agents reach real systems safely, and the pipelines that get them into production. 15+ years across backend services, Kubernetes platforms, and data systems.</p>
      <div class="cta">
        <a href="/projects" class="btn">See projects</a>
        <a href="/resume" class="btn btn-secondary">Download resume</a>
      </div>
    </div>
  </div>

  <section class="stats">
    <div class="container">
      <div class="stat-tile">
        <div class="stat-value">15+</div>
        <div class="stat-label">years of production engineering</div>
      </div>
      <div class="stat-tile">
        <div class="stat-value">6</div>
        <div class="stat-label">agents routing through an MCP server I built</div>
      </div>
      <div class="stat-tile">
        <div class="stat-value">~1M</div>
        <div class="stat-label">rows returned in under 30 seconds from a Postgres reporting layer</div>
      </div>
      <div class="stat-tile placeholder">
        <div class="stat-value">?</div>
        <div class="stat-label">TODO: owner provides metric</div>
      </div>
    </div>
  </section>

  <section class="capabilities">
    <div class="container">
      <h2>Core capabilities</h2>
      <ul>
        <li>Agent integration and MCP protocol design</li>
        <li>Kubernetes and OpenShift platforms</li>
        <li>CI/CD and GitOps pipelines</li>
        <li>Observability and monitoring systems</li>
        <li>Data pipelines and stream processing</li>
      </ul>
    </div>
  </section>

  {featured.length > 0 && (
    <section class="featured-projects">
      <div class="container">
        <h2>Featured projects</h2>
        <div class="projects-grid">
          {featured.map(project => (
            <article class="project-card">
              <h3>
                <a href={`/projects/${project.slug}`}>
                  {project.data.title}
                </a>
              </h3>
              <p>{project.data.summary}</p>
              <div class="card-meta">
                <span>{project.data.year}</span>
                <span>•</span>
                <span>{project.data.role}</span>
              </div>
              <a href={`/projects/${project.slug}`} class="read-more">
                Read more →
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .hero {
    padding: 4rem var(--gutter) 2rem;
  }

  .hero h1 {
    font-size: 3rem;
    margin-bottom: 0.5rem;
  }

  .tagline {
    font-size: 1.5rem;
    color: var(--muted);
    margin-bottom: 1rem;
  }

  .pitch {
    font-size: 1.1rem;
    max-width: var(--measure);
    margin-bottom: 2rem;
  }

  .cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: var(--accent);
    color: var(--bg);
    border-radius: 4px;
    font-weight: 500;
    text-decoration: none;
  }

  .btn:hover {
    opacity: 0.9;
  }

  .btn-secondary {
    background: transparent;
    border: 1px solid var(--accent);
    color: var(--accent);
  }

  .stats {
    padding: 3rem var(--gutter);
    background: var(--surface);
  }

  .stats .container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }

  .stat-tile {
    padding: 1.5rem;
    background: var(--bg);
    border-radius: 6px;
  }

  .stat-tile.placeholder {
    opacity: 0.5;
  }

  .stat-value {
    font-size: 2rem;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }

  .stat-label {
    font-size: 0.9rem;
    color: var(--muted);
  }

  .capabilities {
    padding: 3rem var(--gutter);
  }

  .capabilities h2 {
    margin-bottom: 2rem;
  }

  .capabilities ul {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    max-width: var(--grid-width);
  }

  .capabilities li {
    padding: 1rem;
    border-left: 3px solid var(--accent);
    padding-left: 1rem;
  }

  .featured-projects {
    padding: 3rem var(--gutter);
  }

  .featured-projects h2 {
    margin-bottom: 2rem;
  }

  .featured-projects .projects-grid {
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }

  .project-card {
    padding: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
  }

  .project-card h3 {
    margin-top: 0;
  }

  .project-card a {
    color: var(--accent);
  }

  .card-meta {
    display: flex;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--muted);
    margin: 1rem 0;
  }

  .read-more {
    display: inline-block;
    font-weight: 500;
    text-decoration: none;
  }

  .read-more:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .hero h1 {
      font-size: 2rem;
    }

    .tagline {
      font-size: 1.1rem;
    }

    .cta {
      flex-direction: column;
    }

    .btn {
      width: 100%;
      text-align: center;
    }
  }
</style>
