---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { projectsData } from '../../lib/synced';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { slug: project.id },
    props: { project }
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const meta = projectsData.find(p => p.public_slug === project.id);
const allProjects = [...projectsData].sort((a, b) => (a.sort_order ?? 999) - (b.sort_order ?? 999));
const projectIndex = allProjects.findIndex(p => p.public_slug === project.id);
const prevProject = projectIndex > 0 ? allProjects[projectIndex - 1] : null;
const nextProject = projectIndex >= 0 && projectIndex < allProjects.length - 1 ? allProjects[projectIndex + 1] : null;
---

<Base
  title={`${meta?.name ?? project.id} | Robin Cloutier`}
  description={meta?.description ?? ''}
>
  <article class="project-detail">
    <div class="container">
      <header class="project-header">
        <h1>{meta?.name ?? project.id}</h1>
        <div class="project-meta">
          {meta?.year && <span>{meta.year}</span>}
          {meta?.role && <span>•</span>}
          {meta?.role && <span>{meta.role}</span>}
          {meta?.status && (
            <>
              <span>•</span>
              <span class={`status status-${meta.status}`}>
                {meta.status}
              </span>
            </>
          )}
        </div>
        {meta?.description && <p class="summary">{meta.description}</p>}
        <div class="project-actions">
          {meta?.repo_url && (
            <a href={meta.repo_url} class="btn">
              Repository
            </a>
          )}
          {meta?.demo_url && (
            <a href={meta.demo_url} class="btn">
              Live Demo
            </a>
          )}
        </div>
        {(meta?.stack ?? []).length > 0 && (
          <div class="stack-tags">
            {(meta?.stack ?? []).map(tag => (
              <a href={`/projects?stack=${encodeURIComponent(tag)}`} class="tag">
                {tag}
              </a>
            ))}
          </div>
        )}
      </header>

      <div class="content-wrapper">
        <main class="prose">
          <Content />
        </main>
      </div>

      <nav class="project-nav">
        {prevProject && (
          <a href={`/projects/${prevProject.public_slug}`} class="nav-link prev">
            ← {prevProject.name}
          </a>
        )}
        {nextProject && (
          <a href={`/projects/${nextProject.public_slug}`} class="nav-link next">
            {nextProject.name} →
          </a>
        )}
      </nav>
    </div>
  </article>
</Base>

<style>
  .project-detail {
    padding: 4rem var(--gutter) 3rem;
  }

  .project-header {
    margin-bottom: 3rem;
  }

  .project-header h1 {
    margin-bottom: 0.5rem;
  }

  .project-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.95rem;
    color: var(--muted);
    margin-bottom: 1rem;
  }

  .summary {
    font-size: 1.1rem;
    max-width: var(--measure);
    margin-bottom: 1.5rem;
  }

  .project-actions {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: var(--accent);
    color: var(--bg);
    border-radius: 4px;
    font-weight: 500;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .btn:hover {
    opacity: 0.9;
  }

  .status {
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
  }

  .status-active {
    background: #d4edda;
    color: #155724;
  }

  .status-maintained {
    background: #cce5ff;
    color: #004085;
  }

  .status-archived {
    background: #e2e3e5;
    color: #383d41;
  }

  .status-concept {
    background: #fff3cd;
    color: #856404;
  }

  :root[data-theme="dark"] .status-active {
    background: #1e5631;
    color: #90ee90;
  }

  :root[data-theme="dark"] .status-maintained {
    background: #004085;
    color: #90caf9;
  }

  :root[data-theme="dark"] .status-archived {
    background: #4a4a4a;
    color: #b0b0b0;
  }

  :root[data-theme="dark"] .status-concept {
    background: #664d03;
    color: #ffc107;
  }

  .stack-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    padding: 0.5rem 1rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 20px;
    font-size: 0.85rem;
    color: var(--ink);
    text-decoration: none;
    transition: background-color 0.2s;
  }

  .tag:hover {
    background: var(--accent);
    color: var(--bg);
    border-color: var(--accent);
  }

  .content-wrapper {
    max-width: var(--measure);
    margin: 3rem auto;
  }

  .prose {
    font-size: 1rem;
  }

  .project-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .nav-link {
    padding: 1rem;
    background: var(--surface);
    border-radius: 6px;
    color: var(--ink);
    text-decoration: none;
    transition: transform 0.2s;
  }

  .nav-link:hover {
    transform: translateY(-2px);
  }

  .nav-link.prev {
    text-align: left;
  }

  .nav-link.next {
    text-align: right;
    grid-column: 2;
  }

  @media (max-width: 768px) {
    .project-detail {
      padding: 2rem var(--gutter);
    }

    .project-nav {
      grid-template-columns: 1fr;
    }

    .nav-link.next {
      grid-column: auto;
    }
  }
</style>
