---
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import Base from '../layouts/Base.astro';
import { identity, experience, capabilities } from '../lib/synced';

// The exporter writes public/resume/<basename>.docx; link it only if present
// so a build without it does not 404. The basename matches the exporter's
// PORTFOLIO_RESUME_BASENAME default.
const basename = 'Resume';
const docxPath = `/resume/${basename}.docx`;
const hasDocx = existsSync(resolve('public', 'resume', `${basename}.docx`));
---

<Base
  title="Resume | Robin Cloutier"
  description="Resume and CV of Robin Cloutier."
>
  <div class="resume-container">
    <section class="resume-header">
      <div class="container">
        <h1>Resume</h1>
        <div class="download-links">
          {hasDocx ? (
            <a href={docxPath} class="btn">Download Word resume</a>
          ) : (
            <a href="/resume.json" class="btn btn-secondary">View machine-readable resume</a>
          )}
          <a href="/resume.json" class="btn btn-secondary">resume.json</a>
        </div>
      </div>
    </section>

    <section class="resume-content">
      <div class="container prose">
        <h2>Summary</h2>
        {identity.tagline && <p><strong>{identity.tagline}</strong></p>}
        {identity.pitch && <p>{identity.pitch}</p>}

        <h2>Experience</h2>
        {experience.length === 0 ? (
          <p>No public experience yet.</p>
        ) : (
          experience.map((job) => (
            <div class="role">
              <h3>{job.title}{job.company ? ` — ${job.company}` : ''}</h3>
              {job.years && <p class="years">{job.years}</p>}
              {job.public_note && <p>{job.public_note}</p>}
            </div>
          ))
        )}

        <h2>Skills</h2>
        {capabilities.length === 0 ? (
          <p>No public skills yet.</p>
        ) : (
          <ul>
            {capabilities.map((cap) => (
              <li><strong>{cap.title}:</strong> {cap.description}</li>
            ))}
          </ul>
        )}

        <p class="note">This resume is generated from the same source as the rest of this
        site. A machine-readable copy is available at <a href="/resume.json">/resume.json</a>.</p>
      </div>
    </section>

    <div class="nav-back">
      <div class="container">
        <a href="/">← Back home</a>
      </div>
    </div>
  </div>
</Base>

<style>
  .resume-container {
    min-height: 100vh;
  }

  .resume-header {
    padding: 3rem var(--gutter);
    border-bottom: 1px solid var(--line);
  }

  .resume-header h1 {
    margin-bottom: 2rem;
  }

  .download-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: var(--accent);
    color: var(--bg);
    border-radius: 4px;
    text-decoration: none;
    font-weight: 500;
    transition: opacity 0.2s;
  }

  .btn-secondary {
    background: transparent;
    border: 1px solid var(--accent);
    color: var(--accent);
  }

  .btn:hover {
    opacity: 0.9;
  }

  .resume-content {
    padding: 3rem var(--gutter);
  }

  .resume-content .container {
    max-width: var(--measure);
  }

  .role {
    margin-bottom: 1.5rem;
  }

  .role h3 {
    margin-bottom: 0.25rem;
  }

  .years {
    font-size: 0.9rem;
    color: var(--muted);
  }

  .note {
    margin-top: 2rem;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .nav-back {
    padding: 2rem var(--gutter);
    border-top: 1px solid var(--line);
  }

  .nav-back a {
    color: var(--accent);
  }

  @media print {
    .resume-header,
    .nav-back,
    .download-links {
      display: none;
    }
  }
</style>
